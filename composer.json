{
    "name": "yu-laravel/dns-check",
    "description": "Laravel Livewire tool that checks a domain's DNS and mail records: nameservers, MX, SPF, DKIM, DMARC, CAA and expiry.",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "dns",
        "spf",
        "dmarc"
    ],
    "homepage": "https://github.com/yuriyakishin/laravel-dns-check",
    "license": "MIT",
    "authors": [
        {
            "name": "Yuriy Akishin",
            "email": "yuriy.akishin@gmail.com",
            "homepage": "https://yu.net.ua"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0",
        "yu-laravel/web-tools-core": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Yu\\DnsCheck\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Yu\\DnsCheck\\DnsCheckServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
